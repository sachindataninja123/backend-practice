<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post</title>
</head>
<body>

  <h1>Edit Post</h1>

  <p>Post ID: <%= post.id %></p>
  <p>Username: <%= post.username %></p>

  <form action="/posts/<%= post.id %>/edit?_method=PATCH" method="POST">
    <textarea
      name="content"
      rows="8"
      cols="30"
      placeholder="Enter content"
    ><%= post.content %></textarea>

    <br><br>

    <button type="submit">Save Post</button>
  </form>

</body>
</html>