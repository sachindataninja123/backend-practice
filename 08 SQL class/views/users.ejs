<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
</head>
<body>

<h1>All Users</h1>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% users.forEach(user => { %>

            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>

                <td>
                    <form action="/users/<%= user.id %>/edit" method="GET">
                        <button>Edit Username</button>
                    </form>
                </td>
            </tr>

        <% }) %>
    </tbody>
</table>

</body>
</html>