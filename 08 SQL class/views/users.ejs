<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:#f4f7fb;
            padding:40px;
        }

        h1{
            text-align:center;
            margin-bottom:40px;
        }
        table{
            width:100%;
            border-collapse:collapse;
        }
        th, td{
            padding:10px;
            border:1px solid #ccc;
            text-align:left;
        }

    </style>
</head>
<body>

<h1>All Users</h1>

<table>
    <th>ID</th>
    <th>Username</th>
    <th>Email</th>
    <% users.forEach(user => { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
        </tr>
    <% }) %>
</table>
</div>

</body>
</html>