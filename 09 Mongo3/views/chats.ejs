<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>

   <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>💬 All Chats</h1>

    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>

    <div class="container">

        <% chats.forEach((chat) => { %>

            <div class="chat-card">

                <p>
                    <span class="label">From:</span>
                    <span class="from"><%= chat.from %></span>
                </p>

                <div class="message">
                    <%= chat.message %>
                    <form action="/chats/<%=chat._id  %>/edit" method="GET">
                        <button>
                            Edit
                        </button>
                    </form>
                </div>

                <p>
                    <span class="label">To:</span>
                    <span class="to"><%= chat.to %></span>
                </p>
                <p class="time"><%= chat.created_at.toString().split(" ")[4]  %></p>
                 <p class="date"><%= chat.created_at.toString().split(" ").slice(0,4).join("-")  %></p>

            </div>

        <% }) %>

    </div>

</body>
</html>