<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Post</title>
  </head>
  <body>
    <h1>Edit POST</h1>
    <p>post id: <%= post.id  %></p>
    <p>post username : <%= post.username  %></p>

    <form action="/posts" method="post">
      <textarea rows="8" cols="30" name="content" placeholder="Enter content ">
        <%=post.content  %>
      </textarea>
      <br />
      <button>Save Post</button>
    </form>
  </body>
</html>
